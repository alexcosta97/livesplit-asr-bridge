{
  "$comment": "Brand tokens for LiveSplit One ASR Bridge. Source: .superdesign/design-system.md",
  "color": {
    "background": {
      "window": "#0B0B0C",
      "panel": "#151517",
      "raised": "#1E1E21"
    },
    "border": {
      "default": "#2A2A2E",
      "strong": "#3A3A40"
    },
    "text": {
      "primary": "#F5F5F4",
      "secondary": "#A1A1AA",
      "muted": "#6B6B73"
    },
    "accent": {
      "default": "#FF4D00",
      "hover": "#FF6A26"
    },
    "status": {
      "ok": "#22E07A",
      "waiting": "#A1A1AA",
      "error": "#FF3B3B",
      "warning": "#FFC233"
    },
    "log": {
      "auto-splitter": "#FF4D00",
      "connection": "#7DD3FC",
      "app": "#A1A1AA",
      "error": "#FF3B3B"
    }
  },
  "font": {
    "display": {
      "family": "Archivo Black",
      "file": "fonts/ArchivoBlack-Regular.ttf",
      "case": "uppercase",
      "tracking": "-0.02em"
    },
    "mono": {
      "family": "Space Mono",
      "files": [
        "fonts/SpaceMono-Regular.ttf",
        "fonts/SpaceMono-Bold.ttf"
      ]
    },
    "body": {
      "family": "Inter",
      "files": [
        "fonts/Inter-Regular.ttf",
        "fonts/Inter-SemiBold.ttf"
      ]
    }
  },
  "size": {
    "status-word": 20,
    "status-word-compact": 30,
    "label": 11,
    "body": 14,
    "control": 13,
    "mono": 12
  },
  "space": {
    "unit": 8,
    "card-padding": 16,
    "card-gap": 12,
    "content-padding": 24
  },
  "radius": {
    "card": 4,
    "control": 4,
    "icon": "22%"
  },
  "stroke": {
    "border": 1,
    "status-edge": 3,
    "active-tab": 2
  }
}
